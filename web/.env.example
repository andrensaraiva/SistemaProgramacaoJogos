# =============================================================================
# Plataforma Sistema Jogos Programação — variáveis de ambiente
# =============================================================================
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA commite o .env.local!

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Pegue em: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# -----------------------------------------------------------------------------
# Google Gemini (IA pra gerar exercícios)
# -----------------------------------------------------------------------------
# Pegue em: https://aistudio.google.com/app/apikey
# Os modelos gemini-1.5-* foram aposentados. Use os atuais (flash-latest aponta
# sempre para o flash vigente). Alternativas: gemini-2.5-flash, gemini-3.1-flash-lite.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# -----------------------------------------------------------------------------
# Piston (execução de código C# — self-hosted via Docker)
# -----------------------------------------------------------------------------
# A API pública da emkc.org virou whitelist-only em 15/02/2026.
# Subir um Piston local com Docker:
#   docker volume create piston_data
#   docker run -d --name piston_api --privileged --restart unless-stopped \
#     -v piston_data:/piston -p 2000:2000 ghcr.io/engineer-man/piston:latest
#   curl -X POST http://localhost:2000/api/v2/packages \
#     -H "Content-Type: application/json" \
#     -d '{"language":"dotnet","version":"5.0.201"}'
PISTON_API_URL=http://localhost:2000/api/v2

# -----------------------------------------------------------------------------
# GitHub (opcional — pra integrar com Classroom)
# -----------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
GITHUB_PERSONAL_ACCESS_TOKEN=

# -----------------------------------------------------------------------------
# Feedback anônimo (pesquisa de UC + feedback do professor)
# -----------------------------------------------------------------------------
# Segredo do HMAC do dedupe_hash (impede voto duplo sem revelar o autor).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_SECRET=
