# Normaliza fim de linha: o repositório usa LF. Evita que o Windows (npm, editores)
# reescreva arquivos inteiros em CRLF e polua os diffs (já aconteceu com
# package-lock.json). `text=auto` deixa o Git decidir o que é texto e grava LF
# no repo; os arquivos abaixo são forçados a LF sempre.
* text=auto eol=lf

# Sempre LF (código, config, docs)
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Binários (não tocar)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
